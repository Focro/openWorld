# Пример настроек серверного прокси ИИ (server/ai-proxy.mjs).
# Скопируйте в server/.env на сервере или задайте как секреты хостинга. НИКОГДА не коммитьте настоящие ключи.

# Провайдер по умолчанию: anthropic | openai | deepseek | openrouter
AI_PROVIDER=anthropic

# Ключи сервера (можно задать только нужные). Без ключа сервера игроки могут использовать свои.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Модели по умолчанию. Для OpenAI и OpenRouter модель обязательна, если используется ключ сервера.
AI_ANTHROPIC_MODEL=claude-opus-5-5
AI_OPENAI_MODEL=
AI_DEEPSEEK_MODEL=deepseek-chat
AI_OPENROUTER_MODEL=
AI_EFFORT=low
# Лимит ответа: намерение (короткий JSON) и живая сцена (повествование и реплики людей).
AI_MAX_OUTPUT_TOKENS=200
AI_MAX_SCENE_TOKENS=2000

AI_PROXY_PORT=8787
AI_ALLOWED_ORIGINS=http://localhost:5173
AI_MAX_REQUESTS_PER_MINUTE=6
AI_MAX_REQUESTS_PER_DAY=300
AI_ALLOW_PLAYER_KEYS=true
